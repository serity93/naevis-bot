# --- Discord ---
# Create an application + bot at https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set this during development to register slash commands to a single
# guild instantly instead of waiting up to an hour for global propagation.
DISCORD_DEV_GUILD_ID=

# --- Twitch ---
# Create an app at https://dev.twitch.tv/console/apps
# Redirect URI must include http://localhost:3000/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Comma-separated list of channel names the bot should join, e.g. "yourchannel"
TWITCH_CHANNELS=
# Prefix for Twitch chat commands
TWITCH_COMMAND_PREFIX=!
# Award points for time spent watching a live stream
TWITCH_WATCHTIME_ENABLED=true
# Comma-separated logins that shouldn't earn watchtime — other bots parked in
# the channel. The bot's own account is excluded automatically.
TWITCH_WATCHTIME_IGNORED_USERS=

# --- AI chat ---
# Conversational replies when the bot is mentioned or replied to. Needs a
# local Ollama server — see the AI chat section of the README.
AI_ENABLED=false
# Where Ollama is listening. Under docker compose the bot service overrides
# this to http://ollama:11434; this value is the one `npm run dev` uses.
AI_BASE_URL=http://localhost:11434
# Pin the full tag rather than the short alias, so a change to Ollama's
# default alias can't swap the model out from under the persona.
AI_MODEL=qwen2.5:3b-instruct-q4_K_M
# How long Ollama keeps the model in VRAM between replies. Reloading costs
# 5-15s on modest hardware, paid by whoever mentions the bot next. -1 pins it.
AI_KEEP_ALIVE=30m
# Give up on a generation after this long, measured from when the request was
# accepted rather than from when the GPU became free.
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=160
AI_MAX_INPUT_CHARS=500
AI_MAX_REPLY_CHARS=400
# Per-user gap between AI replies.
AI_COOLDOWN_MS=15000
# How many requests may wait behind the one being generated. Past this the
# bot answers "busy" instead of queueing indefinitely.
AI_QUEUE_LIMIT=2
# Conversation memory: 6 turns is 3 exchanges, kept per channel, dropped
# after AI_HISTORY_TTL_MS of quiet. 0 turns disables it entirely.
AI_HISTORY_TURNS=6
AI_HISTORY_MAX_CHARS=1200
AI_HISTORY_TTL_MS=1200000
# Comma-separated Discord channel ids the bot will chat in. Empty means
# anywhere it can see.
DISCORD_AI_CHANNELS=
# Twitch chat opts in separately, since it's a firehose next to a Discord
# channel.
TWITCH_AI_ENABLED=false

# --- Database ---
# Local Postgres via `docker compose up -d postgres` (see docker-compose.yml)
DATABASE_URL=postgresql://naevis:naevis@localhost:5432/naevis

# --- Misc ---
LOG_LEVEL=info
