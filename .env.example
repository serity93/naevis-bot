# --- Discord ---
# Create an application + bot at https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set this during development to register slash commands to a single
# guild instantly instead of waiting up to an hour for global propagation.
DISCORD_DEV_GUILD_ID=

# --- Twitch ---
# Create an app at https://dev.twitch.tv/console/apps
# Redirect URI must include http://localhost:3000/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Comma-separated list of channel names the bot should join, e.g. "yourchannel"
TWITCH_CHANNELS=
# Prefix for Twitch chat commands
TWITCH_COMMAND_PREFIX=!

# --- Misc ---
LOG_LEVEL=info
