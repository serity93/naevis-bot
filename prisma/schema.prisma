generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  DISCORD
  TWITCH
}

model User {
  id          String   @id @default(cuid())
  platform    Platform
  externalId  String // Discord snowflake or Twitch user id
  username    String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@unique([platform, externalId])
}
