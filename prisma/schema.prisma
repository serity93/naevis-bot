generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  DISCORD
  TWITCH
}

enum PointsReason {
  MESSAGE
}

model User {
  id          String   @id @default(cuid())
  platform    Platform
  externalId  String // Discord snowflake or Twitch user id
  username    String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  // Derived state, rebuildable from ledgerEntries. Cached so balance reads and
  // cooldown checks are O(1); the ledger remains the source of truth.
  points              Int       @default(0)
  lastMessagePointsAt DateTime?

  ledgerEntries PointsLedgerEntry[]

  @@unique([platform, externalId])
}

// Append-only. Nothing updates or deletes rows here — corrections are new rows
// with a negative delta.
model PointsLedgerEntry {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    PointsReason
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}
